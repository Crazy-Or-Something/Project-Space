;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Space"
run/main_scene="uid://c4q0vlmxs21hq"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Profily="*uid://qmnu1ehm866e"
LimboConsole="*uid://dyxornv8vwibg"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Project Space"

[editor_plugins]

